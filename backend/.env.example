# Application
APP_NAME="អុី មីនុយ-E Menu API"
APP_VERSION="0.1.0"
# "development" enables development-only behavior, such as returning password reset
# tokens in API responses. Every other deployment must set ENVIRONMENT="production".
ENVIRONMENT="development"
DEBUG=true
# Base URL of the web frontend, used to build password reset links
FRONTEND_BASE_URL="http://localhost:3000"

# Database (PostgreSQL + asyncpg)
DATABASE_URL="postgresql+asyncpg://user:password@localhost:5433/emenu_dev"


# Redis
REDIS_URL="redis://localhost:6379/0"

# Real-time WebSocket broadcasting: "memory" or "redis".
# "memory" only reaches clients connected to the same process, which is fine
# for local development with a single worker. Production with more than one
# worker or instance MUST use "redis", or POS, KDS and guest updates are lost
# for clients connected to other processes.
REALTIME_BACKEND="memory"

# Security
SECRET_KEY="change-me-to-a-random-64-char-string"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Lifetime of a login session. Refreshing rotates the refresh token but never
# extends the session past this.
REFRESH_TOKEN_EXPIRE_DAYS=14
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
# Concurrent Argon2 hash/verify operations per process (about 64 MiB each)
PASSWORD_HASH_MAX_CONCURRENCY=4

# Rate limiting (fixed window) for login, refresh, registration and password reset.
# "memory" counts per process and is only for development and tests.
# Production must use "redis" (counters shared through REDIS_URL). If Redis is
# unreachable, counting falls back to process memory; limiting never switches off.
RATE_LIMIT_BACKEND="memory"
RATE_LIMIT_REDIS_TIMEOUT_SECONDS=1.0
RATE_LIMIT_LOGIN_PER_IDENTIFIER=10
RATE_LIMIT_LOGIN_PER_IP=50
RATE_LIMIT_LOGIN_WINDOW_SECONDS=900
# Login attempts per account from all IP addresses together. It must stay well
# above RATE_LIMIT_LOGIN_PER_IDENTIFIER with a short window: anyone can spend it,
# so a high limit and short window keep attackers from locking the real user out.
RATE_LIMIT_LOGIN_PER_ACCOUNT=50
RATE_LIMIT_LOGIN_ACCOUNT_WINDOW_SECONDS=300
RATE_LIMIT_REFRESH_PER_IP=300
RATE_LIMIT_REFRESH_WINDOW_SECONDS=900
RATE_LIMIT_REGISTER_PER_IP=10
RATE_LIMIT_REGISTER_WINDOW_SECONDS=3600
RATE_LIMIT_PASSWORD_RESET_PER_IDENTIFIER=5
RATE_LIMIT_PASSWORD_RESET_PER_IP=20
RATE_LIMIT_PASSWORD_RESET_CONFIRM_PER_IP=20
RATE_LIMIT_PASSWORD_RESET_WINDOW_SECONDS=3600

# Reverse proxies (comma-separated IPs or CIDR ranges) whose X-Forwarded-For
# header is trusted for client IPs. Empty means the socket peer address is always
# used. Behind a load balancer, set this or every client shares one rate limit.
TRUSTED_PROXIES=""

# CORS settings
CORS_ORIGINS="*"
